{
  "manifest_version": 3,
  "name": "PaperMemes – Paper Trading Simulator",
  "version": "1.3.0",
  "description": "Simulez vos trades de meme coins Solana en paper trading sur Photon, GMGN, Bullx, Axiom & Padre.",
  "permissions": ["storage", "alarms", "scripting", "activeTab", "notifications", "identity"],
  "host_permissions": [
    "https://photon-sol.tinyastro.io/*",
    "https://gmgn.ai/*",
    "https://bullx.io/*",
    "https://neo.bullx.io/*",
    "https://axiom.trade/*",
    "https://padre.gg/*",
    "https://trade.padre.gg/*",
    "https://frontend-api.pump.fun/*",
    "https://api.rugcheck.xyz/*",
    "https://api.dexscreener.com/*",
    "https://price.jup.ag/*",
    "https://api.binance.com/*",
    "https://translate.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*",
    "https://www.google-analytics.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://photon-sol.tinyastro.io/*",
        "https://gmgn.ai/*",
        "https://bullx.io/*",
        "https://neo.bullx.io/*",
        "https://axiom.trade/*",
        "https://padre.gg/*",
        "https://trade.padre.gg/*"
      ],
      "js": ["content/injector.js"],
      "css": ["assets/overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gmgn.ai/*",
        "https://axiom.trade/*",
        "https://padre.gg/*",
        "https://trade.padre.gg/*"
      ],
      "js": ["content/chart-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "chunks/*", "content/chart-bridge.js"],
      "matches": [
        "https://photon-sol.tinyastro.io/*",
        "https://gmgn.ai/*",
        "https://bullx.io/*",
        "https://neo.bullx.io/*",
        "https://axiom.trade/*",
        "https://padre.gg/*",
        "https://trade.padre.gg/*"
      ]
    }
  ]
}